#!/usr/bin/env ruby
# frozen_string_literal: true

# Sposta na variazione proposta da data/pending/ dint' 'o storico.
# Primma 'e appruvà puoje cagnà a mano 'o file pending: azzeccà
# fonte, na nota, 'a data "existing_from" pe' chi era già abbonato.
#
#   bin/approve netflix-2026-11-02.json
#   bin/approve margherita-2026-11-02.json   # segnalaziune 'e ll'Indice Margherita
#
# Appunì: nu pending cu "amend" nun crea n'evento nuovo, azzecca sulo fonte
# (e si vuò na nota nova) a ll'evento ca tene già chella data.
#   { "service": "spotify", "amend": "2025-08-04", "sources": [...], "note": "..." }

require_relative "../lib/price_monitor"

file = ARGV.fetch(0) { abort "Uso: bin/approve <file in data/pending/>" }
path = File.exist?(file) ? file : PriceMonitor.path("data", "pending", file)
abort "Non trovo #{path}" unless File.exist?(path)

proposal = JSON.parse(File.read(path, encoding: "UTF-8"))

if proposal["dataset"] == "margherita"
  reports = proposal.fetch("reports")
  PriceMonitor::Margherita::Store.load.append_reports!(reports)
  puts "Indice Margherita: #{reports.size} segnalazioni approvate"
  File.delete(path)
  exit
end

service  = proposal.delete("service")
history  = PriceMonitor::History.load

if proposal["amend"]
  event = history.amend_event!(service, proposal["amend"], sources: proposal.fetch("sources"),
                                                           note: proposal["note"])
  puts "Storico di #{service}, evento del #{proposal['amend']}: ora #{event['sources'].size} fonti"
  File.delete(path)
  exit
end

before = history.current(service)
history.append_event!(service, proposal)
after = history.current(service)

puts "Storico di #{service} aggiornato:"
(before.keys | after.keys).sort.each do |plan|
  next if before[plan] == after[plan]

  puts format("  %-16s %s → %s", plan, before[plan] || "—", after[plan] || "rimosso")
end

File.delete(path)
